import { defineConfig, loadEnv } from 'vite';
import react from '@vitejs/plugin-react';
import { federation } from '@module-federation/vite';
import { createRequire } from 'node:module';

const require = createRequire(import.meta.url);

const mf = require('./federation/federation.config.js');

export default defineConfig(({ mode }) => {
  const env = loadEnv(mode, process.cwd(), '');

  console.log('[Vite Federation]');
  console.log('APP_NAME:', env.APP_NAME);
  console.log('APP_PORT:', env.APP_PORT);
  console.log('REMOTE_FORMAT:', env.REMOTE_FORMAT);

  return {
    base: '/',

    server: {
      host: '0.0.0.0',
      port: Number(env.APP_PORT || 5001),
      cors: true
    },

    plugins: [
      react(),

      federation({
        name: env.APP_NAME || 'remote_app',
        filename: 'remoteEntry.js',
        manifest: true,

        exposes: {
          './Button': './src/Button.jsx'
        },

        shared: {
          react: {
            singleton: true,
            requiredVersion: env.REACT_VERSION || '^19.0.0'
          },
          'react-dom': {
            singleton: true,
            requiredVersion: env.REACT_DOM_VERSION || '^19.0.0'
          }
        },

        dts: false
      })
    ]
  };
});
